# Провайдер ИИ: mock | openai | anthropic | proxy
# mock     — встроенная демо-подборка без сети (по умолчанию)
# proxy    — запрос на твой бэкенд (рекомендуется для продакшена, ключи не утекают в браузер)
VITE_AI_PROVIDER=mock

# --- OpenAI ---
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Прокси (свой backend) ---
# POST { VITE_PROXY_URL } body: { answers, system, user } -> { dishes: [...] } (или строка с JSON)
VITE_PROXY_URL=/api/generate

# --- Unsplash (необязательно: фото блюд вместо эмодзи-плейсхолдера) ---
VITE_UNSPLASH_ACCESS_TOKEN=
